{
  "expo": {
    "name": "Virtual Closet",
    "slug": "brody",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "virtualcloset",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brodiedu.virtualcloset",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.brodiedu.virtualcloset"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Virtual Closet to take clothing and outfit photos.",
          "photosPermission": "Allow Virtual Closet to choose clothing and outfit photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6527449-0343-4b89-b17d-95949daccc87"
      }
    },
    "owner": "brodiedu1227",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Virtual Closet"
    }
  }
}
